{
  "coordinate_mode": "absolute",
  "check_interval_seconds": 0.5,
  "show_status": true,
  "count_file": "counts.json",
  "evidence_dir": "evidence",
  "rules": [
    {
      "name": "数値増加回数",
      "detector": "number",
      "action": "count",
      "region": {
        "left": 750,
        "top": 250,
        "width": 180,
        "height": 60
      },
      "condition": {
        "operator": "increase",
        "tolerance": 0,
        "trigger_on_initial": false
      },
      "ocr": {
        "psm": 7,
        "scale": 3.0,
        "threshold": "otsu",
        "invert": false,
        "whitelist": "0123456789",
        "timeout_seconds": 2.0,
        "number_index": 0,
        "border": 10
      },
      "required_matches": 2,
      "save_evidence": true
    },
    {
      "name": "警告数値",
      "detector": "number",
      "action": "sound",
      "sound": "sounds/alert.wav",
      "region": {
        "left": 500,
        "top": 250,
        "width": 180,
        "height": 60
      },
      "condition": {
        "operator": "ge",
        "value": 100,
        "tolerance": 0
      },
      "ocr": {
        "psm": 7,
        "scale": 3.0,
        "threshold": "otsu",
        "invert": false,
        "whitelist": "0123456789.-",
        "timeout_seconds": 2.0,
        "number_index": 0,
        "border": 10
      },
      "required_matches": 2,
      "save_evidence": false
    }
  ]
}
